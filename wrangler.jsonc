{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ne1",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true
  },
  // Back office only: sign-in, admin panel and its API. Every other request is
  // served straight from the static files.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/admin", "/admin/*", "/account", "/account/*", "/auth/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ne-accounts",
      "database_id": "b6442f5e-37ed-4bca-9083-4e2da5cc2886"
    }
  ],
  // Daily at 06:00 UTC (09:00 Nairobi): WhatsApp reward-expiry reminders.
  "triggers": { "crons": ["0 6 * * *"] },
  // Secrets (set in the Cloudflare dashboard, never in this file):
  //   GOOGLE_CLIENT_SECRET, GITHUB_TOKEN, WHATSAPP_TOKEN, META_APP_SECRET
  "vars": {
    "SITE_ORIGIN": "https://nashnaal.com",
    "GOOGLE_CLIENT_ID": "621054563960-gdaku45086r1g12oq1eo0t6p1n32dvbd.apps.googleusercontent.com",
    "ADMIN_EMAILS": "ahmed@nashnaal.com",
    "GITHUB_REPO": "gutale-3/NE1",
    "GITHUB_BRANCH": "main",
    "TECH_DISCOUNT_PERCENT": "5",
    "REWARD_PERCENT": "2",
    "TECH_REWARD_PERCENT": "1",
    // WhatsApp updates number +254 141 444 982 (Cloud API) and the owner's alerts number.
    "WHATSAPP_PHONE_ID": "1311756048696222",
    "WHATSAPP_WABA_ID": "1109082984855157",
    "OWNER_WHATSAPP": "254737454891"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
